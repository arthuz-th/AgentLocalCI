{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/arthuz-th/AgentLocalCI/raw/main/schemas/pipeline.schema.json",
  "title": "AgentLocalCI project pipeline",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project", "default_profile", "dependency_hosts", "environment", "dependencies", "profiles"],
  "properties": {
    "schema_version": { "const": 1 },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[^\\u0000-\\u001f\\u007f]+$" } }
    },
    "default_profile": { "$ref": "#/$defs/id" },
    "dependency_hosts": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "maxLength": 253, "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])$" }
    },
    "environment": { "$ref": "#/$defs/environment" },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "npm": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["working_directory", "lockfile"],
          "properties": {
            "working_directory": { "$ref": "#/$defs/relativePath" },
            "lockfile": { "$ref": "#/$defs/relativePath" }
          }
        },
        "gradle": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["working_directory", "wrapper"],
          "properties": {
            "working_directory": { "$ref": "#/$defs/relativePath" },
            "wrapper": { "$ref": "#/$defs/relativePath" }
          }
        }
      }
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/profile" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "allOf": [
        { "pattern": "^[^:\\u0000-\\u001f\\u007f\"']+$" },
        { "not": { "pattern": "(^[\\\\/]|(^|[\\\\/])\\.\\.?([\\\\/]|$))" } }
      ]
    },
    "environment": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Z][A-Z0-9_]{0,63}$" },
      "additionalProperties": { "type": "string", "maxLength": 4096 }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "acceptance", "gaps", "stages"],
      "properties": {
        "description": { "type": "string", "minLength": 1, "maxLength": 500 },
        "acceptance": { "type": "boolean" },
        "gaps": { "type": "array", "items": { "type": "string", "maxLength": 1000 } },
        "stages": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/stage" } }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "command", "working_directory", "needs", "timeout_seconds"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "command": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "type": "string", "maxLength": 32768 } },
        "working_directory": { "$ref": "#/$defs/relativePath" },
        "needs": { "type": "array", "uniqueItems": true, "items": { "enum": ["npm", "gradle"] } },
        "environment": { "$ref": "#/$defs/environment" },
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 86400 }
      }
    }
  }
}
